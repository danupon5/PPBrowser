<?xml version="1.0" encoding="utf-8"?>
<!--
    "car" build: the full Android Auto setup from RoadBrowser, so PPBrowser shows in Android Auto's
    launcher and media apps. Google Play's normal tracks reject this combination, so this build is
    only for Play Console's Internal app sharing (or installing the APK directly).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="androidx.car.app.ACCESS_SURFACE" />
    <uses-permission android:name="androidx.car.app.MAP_TEMPLATES" />

    <application>
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="7" />
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
    </application>

</manifest>
